---
import { Image } from "astro:assets";
const { img, imgText, name, title, wide = false } = Astro.props;
---

<div class:list={["card", { wide }]}>
  <Image src={img} alt={imgText} />
  <div class="post-it">
    <p class="title">{title}</p>
    <p>{name}</p>
  </div>
</div>

<style>
  .card {
    position: relative;
    z-index: 1;
    place-self: center;
  }

  .post-it {
    background-color: rgb(245, 211, 205);
    width: 140px;
    height: 175px;
    align-content: center;
    padding: 0 30px;
    transform: rotate(-3.5deg);
    box-shadow: var(--dropshadow);
    position: absolute;
    bottom: -70px;
    left: -20px;
  }

  .title {
    font-weight: bold;
    margin-bottom: 0.5ch;
  }

  .card img {
    width: auto;
    height: 400px;
    object-fit: contain;
  }

  p {
    font-size: clamp(18px, 2vw, 20px);
  }

  @media screen and (width > 800px) {
    .card.wide {
      grid-column: span 2;
    }
  }

  @media screen and (width < 800px) {
    .card.wide .post-it {
      bottom: -25px;
    }
  }
</style>
