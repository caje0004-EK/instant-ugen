---
import { Image } from "astro:assets";
const { img, imgText, name, title } = Astro.props;
---

<div class="card">
  <Image src={img} alt={imgText} />
  <div class="post-it">
    <p class="title">{title}</p>
    <p>{name}</p>
  </div>
</div>

<style>
  .card {
    position: relative;
  }
  .post-it {
    background-color: rgb(245, 211, 205);
    width: 140px;
    height: 175px;
    align-content: center;
    padding: 0 30px;
    transform: rotate(-3.5deg);
    box-shadow: var(--dropshadow);
    position: absolute;
    bottom: -20px;
    left: -20px;
  }

  .title {
    font-weight: bold;
  }
</style>
