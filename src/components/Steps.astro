---
interface Props {
    number: number;
    title: string;
    text: string;
    image: string;
}

const { number, title, text, image } = Astro.props;
---

<section class="step">

    <div class="step-content">
        <h2>{number}. {title}</h2>

        <p>{text}</p>
    </div>

    <div class="step-image">
        <img src={image} alt="" />
    </div>

</section>

<style>
    .step {
        padding: 0;
        margin: 0;
    }

    .step-content h2 {
        margin: 0 0 12px;
        color: #f47721;
        font-size: 36px;
        line-height: 1;
        font-family: "Anton", sans-serif;
        font-weight: 400;
    }

    .step-content p {
        margin: 0;
        max-width: 380px;
        font-size: 17px;
        line-height: 1.4;
        font-family: "Inter", sans-serif;
    }

    .step-image {
        margin-bottom: 20px;
    }

    .step-image img {
        display: block;
        width: 180px;
        height: auto;
    }



    @media (max-width: 799px) {

        .step {
            padding: 0 40px;
            margin-bottom: 80px;
            display: flex;
            flex-direction: column;
        }

    
        .step-content {
            order: 1;
        }

        .step-image {
            order: 2;
            margin-top: 20px;
            margin-bottom: 0;
        }

        .step-image img {
            width: 160px;
        }

        .step-content p {
            font-size: 17px;
            max-width: 300px;
        }
    }



   @media (min-width: 800px) {

    .step {
        display: flex;
        width: 100%;
        align-items: center;
    }

    .step-image {
        width: 70%;
        margin: 10px;
    }

    .step-content {
        width: 100%;
    }

    .step-image img {
        width: 180px;
    }
}
</style>