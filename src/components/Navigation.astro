<nav>
  <ul class="menu">
    <div class="menu-content">
      <li><a href="/deltag">Del dine instants</a></li>
      <li><a href="/nominerede">Vindere & nominerede</a></li>
      <li><a href="/praktisk">Praktisk info</a></li>
    </div>
  </ul>
  <button class="burger">
    <span class="line"></span>
    <span class="line"></span>
    <span class="line"></span>
  </button>
  <div class="blur"></div>
</nav>

<style>
  .burger {
    width: 40px;
    height: 20px;
    cursor: pointer;
    display: block;
    background-color: transparent;
    border: 0;
    position: relative;
    z-index: 100;
  }
  .burger .line {
    display: block;
    width: 100%;
    border-radius: var(--border-radius-cta);
    height: 3px;
    margin-bottom: 5.5px;
    transition: 0.2s linear;
    background-color: rgb(0, 0, 0);
  }
  .menu {
    display: none;
  }

  .burger.active .line {
    background-color: rgb(255, 255, 255);
  }
  .burger.active .line:nth-child(1) {
    transform: rotate(45deg) translate(6px, 6px);
    transition: 0.2s linear;
  }
  .burger.active .line:nth-child(2) {
    opacity: 0;
    transition: 0.15s linear;
  }
  .burger.active .line:nth-child(3) {
    transform: rotate(-45deg) translate(6px, -6px);
    transition: 0.2s linear;
  }
  nav.active .menu {
    display: block;
    position: absolute;
    top: 100px;
    height: 100%;
    width: 100%;
    z-index: 50;
    background-color: var(--header-active-color);
    padding: 0 3rem;
    top: 0;
    padding-top: 80px;
    transition:
      opacity 0.4s,
      transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @starting-style {
    nav.active .menu {
      opacity: 0;
      transform: translateX(30px);
    }
  }

  .menu-content {
    display: flex;
    flex-direction: column;
    gap: 10ch;
    padding-top: 10ch;
  }

  :global(body.no-scroll) {
    overflow: hidden;
  }

  li {
    position: relative;
  }

  li a {
    display: inline-block;
  }

  li a::after {
    content: "→";
    position: absolute;
    opacity: 0;
    transition: 0.2s ease;
    margin-left: 1ch;
    width: 20px;
    transform: scaleX(1.9);
  }

  li a:hover::after {
    opacity: 1;
  }

  @media screen and (width > 800px) {
    nav.active .menu {
      width: 60%;
      right: 0;
    }

    nav.active .blur {
      position: absolute;
      width: 100%;
      height: 100%;
      backdrop-filter: blur(5px);
      left: 0;
      top: 0;
      z-index: 40;
    }
  }

  @media screen and (width <= 800px) {
    nav.active .menu {
      left: 0;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const burger = document.querySelector(".burger");
    const nav = document.querySelector("nav");

    if (burger && nav) {
      burger.addEventListener("click", () => {
        burger.classList.toggle("active");
        nav.classList.toggle("active");
        document.body.classList.toggle("no-scroll");
      });
    }
  });
</script>
