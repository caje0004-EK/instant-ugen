---
import PageLayout from "../layouts/PageLayout.astro";
import DelHero from "../components/DelHero.astro";
import Step from "../components/Steps.astro";
import Terms from "../components/Terms.astro";
import tagImg from "../assets/fotos/tag-img.png";
import uploadImg from "../assets/fotos/upload-img.png";
import betingelserImg from "../assets/fotos/betingelser-img.png";
import indsendImg from "../assets/fotos/indsend-img.png";
---

<PageLayout heading="Instant Ugen | Del dine instants">
	<DelHero />
    <section class="steps">
    <div class="step-1">
        <Step
            number={1}
            title="Tag billede"
            text="Tag et billede af dit instant foto med din smartphone (eller scan det for den bedste kvalitet) - filen skal være mellem 2-10 MB, i jpg/jpeg- eller webp-format."
                image={tagImg.src}
        />
    </div>
    <div class="step-2">
        <Step
            number={2}
            title="Upload"
            text="Upload dit billede og dit navn + kontaktinfo på [link til din “del dine instants”-side]"
            image={uploadImg.src}
        />
    </div>
    <div class="step-3">
        <Step
            number={3}
            title="Betingelser"
            text="Accepter vilkår og betingelser for konkurrencen [link til afsnittet “vilkår og betingelser” på siden “del dine instants”. Den korte version: Deltagere skal være over 18 år, portrætterede personer skal have givet samtykke, og du accepterer, at dit instant foto må udstilles og bruges til at promovere fotokonkurrencen."
            image={betingelserImg.src}
        />
    </div>
    <div class="step-4">
        <Step
            number={4}
            title="Indsend"
            text="Du kan indsende op til 5 bidrag - gennemgå trin 1-3 for hver indsendelse ;-)"
            image={indsendImg.src}
        />
    </div>
</section>
<Terms />
</PageLayout>

<style>
    .steps {
        width: 90%;
        max-width: 1000px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
    }

    @media (min-width: 800px) {

        .steps {
            grid-template-columns: 1fr 1fr;
            column-gap: 100px;
            row-gap: 0;
        }

        .step-1 {
            grid-column: 1;
            grid-row: 1;
        }

        .step-2 {
            grid-column: 2;
            grid-row: 1;
            margin-top: 150px;
        }

        .step-3 {
            grid-column: 1;
            grid-row: 2;
            margin-top: 50px;
        }

        .step-4 {
            grid-column: 2;
            grid-row: 2;
            margin-top: 250px;
        }
    }
</style>

